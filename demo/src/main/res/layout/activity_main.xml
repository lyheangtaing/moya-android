<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/title"
            android:textColor="@color/ink"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitle"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/DemoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/username"
                android:text="@string/username" />

            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLength="39"
                android:singleLine="true"
                android:text="@string/default_username"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                style="@style/DemoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/request_mode" />

            <RadioGroup
                android:id="@+id/request_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checkedButton="@id/live_mode"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/live_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/live_mode"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/stub_mode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/stub_mode"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/request_preview"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/send_request"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/send_button"
                android:minHeight="52dp"
                android:text="@string/send_request"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/DemoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/response_title" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/empty_response"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/profile_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/profile_counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
